generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model App {
  id              String   @id @default(cuid())
  name            String
  icon            String
  description     String
  category        String
  version         String
  size            String
  updatedAt       DateTime @updatedAt
  minRequirements String
  changelog       String
  downloadUrl     String
  status          String
  rating          Float?
  createdAt       DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  tags        String
  url         String
  github      String
  color       String
  createdAt   DateTime @default(now())
}

model Post {
  id        String    @id @default(cuid())
  title     String
  excerpt   String
  content   String
  tag       String
  emoji     String
  readTime  String
  likes     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  author    String
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
